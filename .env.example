# Production Database connection string (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Flask App Configuration
PORT=5000
FLASK_ENV=production
SECRET_KEY=change-this-to-a-secure-random-secret

# Frontend Allowed Origin for CORS
CORS_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173

# Supabase Storage (for product photos)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
